# Local development values only. Never commit backend/.env.
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=itsinda_db
DB_CONNECTION_LIMIT=10
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# Exact origins only; no paths. In production, include every deployed frontend origin.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only when running behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
